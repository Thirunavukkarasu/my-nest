{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "files.exclude": {
    "**/.expo": true,
    "**/node_modules": true,
    "**/.next": true
  },
  "cSpell.words": ["creditcard", "Criterias", "exclamationmark", "neondatabase"]
}
